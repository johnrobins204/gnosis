# Example Python test file for the backlog (to be placed at tests/test_backlog/test_project_backlog.py)
# (This is a real pytest test file.)

import json
import os
import pytest

BACKLOG_PATH = os.path.join(os.path.dirname(__file__), '../../backlog/project_backlog.json')

def test_backlog_file_exists():
  assert os.path.exists(BACKLOG_PATH), f"{BACKLOG_PATH} does not exist"
  with open(BACKLOG_PATH, 'r') as f:
    data = json.load(f)
  assert isinstance(data, dict)

def test_backlog_has_tasks():
  with open(BACKLOG_PATH, 'r') as f:
    data = json.load(f)
  assert 'tasks' in data
  assert isinstance(data['tasks'], list)
  assert len(data['tasks']) > 0

@pytest.mark.parametrize("required", [
  "id", "title", "description", "files", "acceptance_criteria", "status", "priority"
])
def test_task_fields(required):
  with open(BACKLOG_PATH, 'r') as f:
    data = json.load(f)
  for task in data['tasks']:
    assert required in task, f"Task {task.get('id', '?')} missing field: {required}"